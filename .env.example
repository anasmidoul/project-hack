# Copy to .env and fill in. Empty values use the defaults in housia/config.py.
HOUSIA_DB=instance/housia.db
PORT=5000
BASE_URL=http://localhost:5000
CHANNEL=mock
DEFAULT_PROPERTY_ID=1
WORKER_INTERVAL_SEC=20
REPLY_ENGINE=template
LLM_PROVIDER=openai
REPLY_MODEL=
BROWSER_MODEL=
SEND_ALLOWLIST=
CHROME_PROFILE_DIR=~/housia-profile
IDEALISTA_INBOX_URL=http://localhost:5000/mock/inbox
BROWSER_ALLOWED_DOMAINS=localhost
OPENAI_API_KEY=
SECRET_KEY=

# Optional: browser binary for browser-use (default: Google Chrome, then Chromium).
# Log in by hand with the same binary, started with --password-store=basic.
BH_CHROME_PATH=

# Required with a strong SECRET_KEY and HTTPS when serving real applicant links, and by
# scripts/demo_public.sh (public tunnel). Owner sign-in uses username: owner
OWNER_PASSWORD=
# Optional AI explanations; only the result category is sent to the configured model.
WORKSPACE_AI_NOTES=0

# Optional local demo data added after the seed on reset (git-ignored file).
DEMO_EXTRA_FILE=instance/demo_extra.json
