# Copy to .env and fill in. Empty values use the defaults in housia/config.py.
HOUSIA_DB=instance/housia.db
PORT=5000
BASE_URL=http://localhost:5000
CHANNEL=mock
DEFAULT_PROPERTY_ID=1
WORKER_INTERVAL_SEC=20
REPLY_ENGINE=template
LLM_PROVIDER=openai
REPLY_MODEL=
BROWSER_MODEL=
SEND_ALLOWLIST=
CHROME_PROFILE_DIR=~/housia-profile
IDEALISTA_INBOX_URL=http://localhost:5000/mock/inbox
BROWSER_ALLOWED_DOMAINS=localhost
OPENAI_API_KEY=
SECRET_KEY=

# Optional: browser binary for browser-use (default: Google Chrome, then Chromium).
# Log in by hand with the same binary, started with --password-store=basic.
BH_CHROME_PATH=
